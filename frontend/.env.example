# URL base de la API.
# Back-end Laravel propio:   http://localhost:8000/api
# API simulada (npm run mock): http://localhost:3001/api
# Codespaces: use la URL HTTPS del puerto 8000 que aparece en la pestaña Ports.
# Mantenga VITE_API_URL para definir la URL explícita de la API.
VITE_API_URL=http://localhost:8000/api
